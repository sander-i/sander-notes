# Giscus 评论配置（可选）。四项全部填写后评论区才会渲染。
# 获取方式：https://giscus.app/zh-CN
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GOATCOUNTER_CODE=sander
PUBLIC_GOATCOUNTER_HOSTS=sander-notes.sander-o.workers.dev,sander.cloudzyro.app,sander-i.github.io

# 设为 true 时全站输出 <meta name="robots" content="noindex">，且不输出 canonical。
# GitHub Pages 镜像站用这个值，避免与主站重复收录。
PUBLIC_NOINDEX=
