---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateLabel } from '../../lib/date';
import { analytics } from '../../lib/analytics';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
// 这些值会直接出现在页面 HTML 里，不是秘密。给默认值是为了让本地、CI 和
// Workers Builds 三条构建链路都不用额外配环境变量就能渲染评论区。
// 注意空字符串要回落到默认值：CI 里未定义的 vars.* 会被展开成空串。
const envOr = (value: string | undefined, fallback: string) => (value?.trim() ? value.trim() : fallback);
const commentsConfig = {
  repo: envOr(import.meta.env.PUBLIC_GISCUS_REPO, 'sander-i/sander-notes'),
  repoId: envOr(import.meta.env.PUBLIC_GISCUS_REPO_ID, 'R_kgDOVy31SA'),
  category: envOr(import.meta.env.PUBLIC_GISCUS_CATEGORY, 'Announcements'),
  categoryId: envOr(import.meta.env.PUBLIC_GISCUS_CATEGORY_ID, 'DIC_kwDOVy31SM4DLeGj'),
};
const commentsReady = Object.values(commentsConfig).every(Boolean);
const viewsPath = analytics.normalizePath(Astro.url.pathname);
---
<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <article class="article" data-pagefind-body>
    <header class="article-header">
      <a class="back-link" href={base}>所有文章</a>
      <h1>{post.data.title}</h1>
      <p class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time>{post.data.updatedDate && <span>更新于 <time datetime={post.data.updatedDate.toISOString()}>{dateLabel(post.data.updatedDate)}</time></span>}{post.data.tags.length > 0 && <span>{post.data.tags.join('、')}</span>}</p>
      <p class="article-description">{post.data.description}</p>
      {analytics.enabled && (
        <p class="article-views">
          <span
            data-goatcounter-views
            data-code={analytics.code}
            data-hosts={analytics.hosts.join(',')}
            data-path={viewsPath}
          ></span>
        </p>
      )}
    </header>
    <div class="prose"><Content /></div>
  </article>
  {commentsReady && (
    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">评论</h2>
      <script src="https://giscus.app/client.js" data-repo={commentsConfig.repo} data-repo-id={commentsConfig.repoId} data-category={commentsConfig.category} data-category-id={commentsConfig.categoryId} data-mapping="title" data-strict="0" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="bottom" data-theme="light" data-lang="zh-CN" crossorigin="anonymous" async></script>
    </section>
  )}
  <script>
    const giscusTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    const applyGiscusTheme = () => {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      iframe?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        'https://giscus.app',
      );
    };
    let bound = false;
    const bindGiscus = () => {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!iframe) return false;
      if (!bound) {
        iframe.addEventListener('load', applyGiscusTheme);
        bound = true;
      }
      applyGiscusTheme();
      return true;
    };
    if (!bindGiscus()) {
      const observer = new MutationObserver(() => {
        if (bindGiscus()) observer.disconnect();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
    window.addEventListener('themechange', applyGiscusTheme);
  </script>
  <script>
    // 各部署目标分别计数，页面显示的是同一篇文章在各站点的合计。
    const viewsEl = document.querySelector<HTMLElement>('[data-goatcounter-views]');
    const parseCount = (value: unknown) => Number(String(value ?? '').replace(/[^\d]/g, '')) || 0;
    if (viewsEl) {
      const { code, hosts, path } = viewsEl.dataset;
      const paths = (hosts ?? '').split(',').filter(Boolean).map((host) => `/${host}${path}`);
      if (code && paths.length > 0) {
        Promise.all(
          paths.map((p) =>
            fetch(`https://${code}.goatcounter.com/counter/${p}.json`)
              .then((res) => res.json())
              .then((data) => parseCount(data.count))
              .catch(() => 0),
          ),
        ).then((counts) => {
          const total = counts.reduce((sum, n) => sum + n, 0);
          viewsEl.textContent = total > 0 ? `阅读 ${total.toLocaleString('zh-CN')} 次` : '';
        });
      }
    }
  </script>
</BaseLayout>
