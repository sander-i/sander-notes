---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<BaseLayout title="页面不存在" description="没有找到这个页面。" noindex>
  <section class="search-page">
    <a class="back-link" href={base}>所有文章</a>
    <h1>404</h1>
    <p class="search-hint">这个页面不存在，可能已经移动或删除。</p>
  </section>
</BaseLayout>
